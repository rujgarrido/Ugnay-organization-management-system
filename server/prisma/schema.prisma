// TaskFlow — Prisma schema
//
// Status: placeholder. Do NOT add models here until the ERD in
// docs/database.md is finalized (implementation guide, Section 8).
// Models should be a translation of an already-agreed design, not
// designed directly in this file.

// Phase 3.6 — reflects decisions locked in Phase 3.5 (RBAC & Authorization Design):
//   - DB-backed refresh tokens (rotated on use), httpOnly cookie transport
//   - Access JWT carries only userId — org membership/permissions resolved fresh per request
//   - Single-source RBAC (Position -> Permission). Committee Head is an ownership/scope
//     check in the service layer, NOT a second permission source (see CommitteeMember.isHead)
//   - Proposal state machine trimmed to 5 core states + 3 terminal exception states

// Phase 3.7 — native PostgreSQL type tightening pass (no columns added/removed):
//   - Every id/FK field now @db.Uuid. Without it, Prisma's `String` maps to `text`
//     for a value that is always a 16-byte UUID — 4x the storage, no format
//     validation at the DB layer, and it silently accepts non-UUID garbage.
//   - Every DateTime field now @db.Timestamptz(3). This is the one that actually
//     bites in production: Prisma's DateTime on postgresql defaults to
//     `TIMESTAMP(3)` WITHOUT time zone, not `TIMESTAMPTZ`. Every timestamp gets
//     silently interpreted in whatever the DB session's timezone happens to be —
//     correct in dev (usually UTC), wrong the moment a client or connection pool
//     is in another zone. This is a bug hiding in the default, not a style choice.
//   - id defaults now use dbgenerated("gen_random_uuid()") so the UUID is
//     generated by Postgres, not by Prisma's JS-side uuid() — matches how the
//     raw SQL migrations already do it and keeps ID generation correct even for
//     rows inserted outside Prisma (seed scripts, manual fixes, other services).
//   - Free-text String fields sized with @db.VarChar(n) or @db.Text based on
//     what they actually hold, instead of every String silently becoming `text`.
//   - RefreshToken.tokenHash constrained to VarChar(64) — a sha256 hex digest is
//     always exactly 64 characters; anything else stored there is already a bug.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────────────────

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.Text
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  memberships   OrganizationMember[]
  refreshTokens RefreshToken[]

  @@index([email])
}

// One row per issued refresh token. Rotated on every /auth/refresh call:
// the old row is marked revoked, a new row is issued. Enables real revocation
// (logout, "log out everywhere", compromised-token response) that a stateless
// JWT refresh token cannot provide.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64) // sha256 hex digest — always 64 chars, never store the raw token
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────
// ORGANIZATION / RBAC
// ─────────────────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  members     OrganizationMember[]
  positions   Position[]
  committees  Committee[]
  projects    Project[]
  proposals   Proposal[]
  activityLog ActivityLog[]
}

model OrganizationMember {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  positionId     String    @db.Uuid
  isActive       Boolean   @default(true)
  joinedAt       DateTime  @default(now()) @db.Timestamptz(3)
  removedAt      DateTime? @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  position     Position           @relation(fields: [positionId], references: [id])

  committeeMemberships CommitteeMember[]
  assignedTasks         Task[]            @relation("TaskAssignee")
  createdTasks           Task[]           @relation("TaskCreatedBy")
  createdProjects        Project[]        @relation("ProjectCreatedBy")
  createdProposals        Proposal[]      @relation("ProposalCreatedBy")
  responsibleForProposals Proposal[]      @relation("ProposalResponsibleMember")
  activityLogEntries       ActivityLog[]

  // A member has exactly one primary Position for MVP (see handoff doc, Section 8).
  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Position {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  name           String  @db.VarChar(100)
  description    String? @db.Text

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  permissions  PositionPermission[]

  @@unique([organizationId, name])
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(100) // e.g. CREATE_PROJECT, ASSIGN_TASK, MANAGE_MEMBERS
  description String? @db.Text

  positions PositionPermission[]
}

model PositionPermission {
  positionId   String @db.Uuid
  permissionId String @db.Uuid

  position   Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([positionId, permissionId])
}

// ─────────────────────────────────────────────────────────
// COMMITTEES
// isHead is an ownership flag, not a permission grant. Authorization for
// committee-scoped actions (e.g. "assign task within my committee") is
// resolved in the service layer as: base Position permission OR isHead
// scope check — see Phase 3.5 decision. No CommitteePermission table.
// ─────────────────────────────────────────────────────────

model Committee {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      CommitteeMember[]

  @@unique([organizationId, name])
}

model CommitteeMember {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  committeeId           String  @db.Uuid
  organizationMemberId  String  @db.Uuid
  isHead                Boolean @default(false)

  committee           Committee           @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  organizationMember   OrganizationMember  @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([committeeId, organizationMemberId])
}

// ─────────────────────────────────────────────────────────
// PROJECTS / TASKS
// No ProjectMember table — access resolved via org membership + visibility
// + permissions (handoff doc, Section 13). Do not reintroduce it for MVP.
// ─────────────────────────────────────────────────────────

enum ProjectVisibility {
  ORG_WIDE
  RESTRICTED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  name           String            @db.VarChar(255)
  description    String?           @db.Text
  visibility     ProjectVisibility @default(ORG_WIDE)
  status         ProjectStatus     @default(ACTIVE)
  createdById    String            @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    OrganizationMember @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  tasks        Task[]
  proposals    Proposal[]

  @@index([organizationId])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model Task {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String       @db.Uuid
  title       String       @db.VarChar(255)
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(BACKLOG)
  assigneeId  String?      @db.Uuid // nullable — task may be unassigned
  createdById String       @db.Uuid
  dueDate     DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  OrganizationMember? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy OrganizationMember  @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────
// PROPOSALS
// Status enum reflects the trimmed 5-state + 3-terminal-exception machine
// locked in this conversation. Transition legality is enforced in the
// service layer via an explicit ALLOWED_TRANSITIONS map — do not rely on
// the enum alone to prevent illegal transitions (e.g. DRAFT -> COMPLETED).
// ─────────────────────────────────────────────────────────

enum ProposalStatus {
  DRAFT
  SUBMITTED
  AWAITING_SIGNATURES
  SUBMITTED_TO_OFFICE
  COMPLETED
  NEEDS_REVISION
  REJECTED
  CANCELLED
}

model Proposal {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String         @db.Uuid
  projectId           String?        @db.Uuid // optional — proposal may not belong to a project
  title               String         @db.VarChar(255)
  description         String?        @db.Text
  status              ProposalStatus @default(DRAFT)
  responsibleMemberId String?        @db.Uuid // nullable
  createdById         String         @db.Uuid
  dueDate             DateTime?      @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project?            @relation(fields: [projectId], references: [id])
  responsibleMember  OrganizationMember? @relation("ProposalResponsibleMember", fields: [responsibleMemberId], references: [id])
  createdBy          OrganizationMember  @relation("ProposalCreatedBy", fields: [createdById], references: [id])
  signatures          ProposalSignature[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
}

enum SignatureStatus {
  PENDING
  COMPLETED
}

model ProposalSignature {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId    String          @db.Uuid
  signatoryName String          @db.VarChar(255)
  signatoryRole String          @db.VarChar(100)
  status        SignatureStatus @default(PENDING)
  completedAt   DateTime?       @db.Timestamptz(3)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

// ─────────────────────────────────────────────────────────
// ACTIVITY LOG
// Append-only. Application layer must not expose update/delete for this
// model — enforce at the service layer (no repository method for it).
// ─────────────────────────────────────────────────────────

model ActivityLog {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @db.Uuid
  organizationMemberId String   @db.Uuid
  action               String   @db.VarChar(100) // e.g. "created_task", "assigned_task", "submitted_proposal"
  entityType           String   @db.VarChar(100) // e.g. "Task", "Proposal", "Project"
  entityId             String   @db.Uuid
  metadata             Json?    @db.JsonB
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id])

  @@index([organizationMemberId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
