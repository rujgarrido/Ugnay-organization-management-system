# Copy to server/.env — never commit the real .env

NODE_ENV=development
PORT=4000

# Must match docker-compose Postgres credentials
DATABASE_URL="postgresql://taskflow:taskflow_dev_password@localhost:5432/taskflow?schema=public"

# Generate a strong random value for real use
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
